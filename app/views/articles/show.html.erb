<%# SEO & Meta Tags de Título %>
<% content_for :title, "#{@article.title} — Blog" %>
<article class="min-h-screen bg-white ">
  <%# ========================================== %>
  <%# 1. CABEÇALHO DO ARTIGO (HERO HEADER)       %>
  <%# ========================================== %>
  <header class="relative pt-8 pb-12 bg-slate-900 text-white overflow-hidden">
    <% if @article.cover.attached? %>
      <%= image_tag @article.cover, 
                    class: "absolute inset-0 w-full h-full object-cover opacity-25 filter blur-sm scale-105", 
                    alt: @article.title %>
    <% end %>
    <%# Overlay Gradiente Escuro %>
    <div class="absolute inset-0 bg-gradient-to-t from-slate-900 via-slate-900/80 to-transparent"></div>
    <div class="relative z-10 max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 pt-6">
      <%# Botão Voltar + Ações de Admin %>
      <div class="flex items-center justify-between mb-8">
        <%= link_to articles_path, class: "inline-flex items-center gap-2 text-xs sm:text-sm font-medium text-slate-300 hover:text-white transition-colors bg-white/10 backdrop-blur-md px-3.5 py-1.5 rounded-full border border-white/10" do %>
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
          </svg>
          Voltar para os artigos
        <% end %>
        <% if authenticated? %>
          <div class="flex items-center gap-2">
            <%= link_to edit_article_path(@article), class: "inline-flex items-center gap-1.5 text-xs font-semibold px-3 py-1.5 bg-indigo-600 hover:bg-indigo-500 text-white rounded-lg transition-colors shadow-sm" do %>
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/>
              </svg>
              Editar
            <% end %>
            <%= button_to article_path(@article), method: :delete, data: { turbo_confirm: "Tem certeza que deseja apagar este artigo?" }, class: "inline-flex items-center gap-1.5 text-xs font-semibold px-3 py-1.5 bg-red-500/20 hover:bg-red-500/30 text-red-200 border border-red-500/30 rounded-lg transition-colors cursor-pointer" do %>
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/>
              </svg>
              Excluir
            <% end %>
          </div>
        <% end %>
      </div>
      <%# Categoria %>
      <div class="mb-4">
        <span class="inline-block px-3 py-1 bg-indigo-500/20 text-indigo-300 border border-indigo-500/30 text-xs font-semibold rounded-full uppercase tracking-wider backdrop-blur-sm">
          <%= @article.category.name %>
        </span>
      </div>
      <%# Título Principal %>
      <h1 class="text-3xl sm:text-5xl font-black tracking-tight text-white leading-tight mb-6">
        <%= @article.title %>
      </h1>
      <%# Subtítulo / Excerpt %>
      <% if @article.excerpt.present? %>
        <p class="text-lg sm:text-xl text-slate-300 font-normal leading-relaxed mb-8 max-w-3xl">
          <%= @article.excerpt %>
        </p>
      <% end %>
      <%# Metadados do Autor e Publicação %>
      <div class="flex flex-wrap items-center gap-4 text-xs sm:text-sm text-slate-400 border-t border-slate-800 pt-6">
        <div class="flex items-center gap-2">
          <div class="w-8 h-8 rounded-full bg-indigo-600 flex items-center justify-center font-bold text-white text-xs">
            <%= @article.author_name[0] %>
          </div>
          <span class="font-semibold text-slate-200"><%= @article.author_name %></span>
        </div>
        <span>•</span>
        <div class="flex items-center gap-1.5">
          <svg class="w-4 h-4 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
          </svg>
          <%= l(@article.published_at || @article.created_at, format: :long) %>
        </div>
        <span>•</span>
        <div class="flex items-center gap-1.5">
          <svg class="w-4 h-4 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
          </svg>
          <%= @article.reading_time %> min de leitura
        </div>
      </div>
    </div>
  </header>
  <%# ========================================== %>
  <%# 2. IMAGEM DE CAPA EM DESTAQUE              %>
  <%# ========================================== %>
  <% if @article.cover.attached? %>
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 -mt-8 relative z-20">
      <div class="rounded-2xl overflow-hidden shadow-2xl border border-slate-100 max-h-[480px]">
        <%= image_tag @article.cover, class: "w-full h-full object-cover", alt: @article.title %>
      </div>
    </div>
  <% end %>
  <%# ========================================== %>
  <%# 3. CORPO DO ARTIGO (ACTION TEXT / TRIX)   %>
  <%# ========================================== %>
  <main class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-12 sm:py-16">
    <div class="prose prose-lg prose-indigo max-w-none prose-headings:font-bold prose-headings:tracking-tight prose-img:rounded-2xl prose-img:shadow-md">
      <%= @article.content %>
    </div>
    <%# Barra de Engajamento: Visualizações + Likes/Dislikes %>
    <div class="mt-10 flex flex-wrap items-center justify-between gap-4 rounded-2xl border border-slate-200 bg-slate-50 px-6 py-4">
      <div class="flex items-center gap-2 text-sm text-slate-600">
        <svg class="w-5 h-5 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/>
        </svg>
        <span class="font-semibold text-slate-900"><%= @article.views_count %></span>
        <span>visualizações</span>
      </div>
      <%= render "articles/votes", article: @article, user_vote: @user_vote %>
    </div>
    <%# Rodapé do Artigo: Voltar %>
    <footer class="mt-8 pt-8 border-t border-slate-100 flex items-center justify-between">
      <%= link_to articles_path, class: "inline-flex items-center gap-2 text-sm font-semibold text-indigo-600 hover:text-indigo-800 transition-colors" do %>
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
        </svg>
        Ver todos os artigos
      <% end %>
    </footer>
  </main>
</article>
