<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 my-6">
  <div class="relative flex items-center justify-center border-b border-gray-200 pb-4">
    <%# 1. ESPAÇADOR/ESTRUTURA VAZIA NA ESQUERDA (Para balancear a largura do botão e manter o centro perfeito) %>
    <% if authenticated? %>
      <div class="hidden sm:block w-32 shrink-0"></div>
    <% end %>
    <%# 2. CATEGORIAS %>
    <div class="flex flex-wrap items-center justify-center gap-2 flex-1">
      <% @categories.each do |category| %>
        <%= link_to category_path(category), class: "px-3 py-1.5 bg-gray-800 text-xs font-medium text-gray-200 rounded-lg border border-gray-700 hover:border-[#E23D5B] hover:text-[#E23D5B] transition-colors shadow-sm" do %>
          <%= category.name %> <span class="font-normal">(<%= category.articles_count %>)</span>
        <% end %>
      <% end %>
    </div>
    <%# 3. BOTÃO NOVO ARTIGO (Fixado totalmente à direita) %>
    <% if authenticated? %>
      <div class="sm:absolute sm:right-0 shrink-0">
        <%= link_to new_article_path, class: "inline-flex items-center gap-1.5 px-3.5 py-1.5 text-xs font-semibold text-indigo-600 hover:text-white bg-indigo-50 hover:bg-indigo-600 rounded-lg transition-all border border-indigo-100 shadow-sm" do %>
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
          </svg>
          Novo Artigo
        <% end %>
      </div>
    <% end %>
  </div>
</div>
<%# ########################################################################## %>
<%# ########################################################################## %>
<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
  <%# ========================================== %>
  <%# HERO / ARTIGO EM DESTAQUE                 %>
  <%# ========================================== %>
  <% if @featured_article %>
    <section class="mb-12">
      <div class="relative rounded-2xl overflow-hidden bg-gray-900 text-white shadow-xl group">
        <% if @featured_article.cover.attached? %>
          <%= image_tag @featured_article.cover, 
                        class: "absolute inset-0 w-full h-full object-cover opacity-40 group-hover:scale-105 transition-transform duration-500 ease-out", 
                        alt: @featured_article.title %>
        <% else %>
          <img src="https://images.unsplash.com/photo-1498050108023-c5249f4df085?auto=format&fit=crop&w=1200&q=80" 
               alt="Capa padrão" 
               class="absolute inset-0 w-full h-full object-cover opacity-40 group-hover:scale-105 transition-transform duration-500 ease-out" />
        <% end %>
        <div class="relative z-10 p-6 sm:p-10 lg:p-12 max-w-3xl">
          <span class="inline-block px-3 py-1 bg-indigo-600 text-white text-xs font-semibold rounded-full uppercase tracking-wider mb-4">
            <%= @featured_article.category.name %>
          </span>
          <h1 class="text-2xl sm:text-4xl font-extrabold tracking-tight mb-4 leading-tight">
            <%= link_to @featured_article.title, article_path(@featured_article), class: "hover:underline" %>
          </h1>
          <p class="text-gray-200 text-sm sm:text-base mb-6 line-clamp-2">
            <%= @featured_article.excerpt %>
          </p>
          <div class="flex items-center text-xs sm:text-sm text-gray-300 gap-4">
            <span class="font-medium text-white">Por <%= @featured_article.author_name %></span>
            <span>•</span>
            <span><%= l(@featured_article.published_at, format: :short) if @featured_article.published_at %></span>
            <span>•</span>
            <span><%= @featured_article.reading_time %> min de leitura</span>
          </div>
        </div>
      </div>
    </section>
  <% end %>
  <%# ========================================== %>
  <%# GRID PRINCIPAL DE 2 COLUNAS (70/30)        %>
  <%# ========================================== %>
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-8">
    <%# COLUNA PRINCIPAL (8 de 12 colunas) %>
    <main class="lg:col-span-8 space-y-12">
      <section>
        <div class="flex items-center justify-between border-b border-gray-200 pb-3 mb-6">
          <h2 class="text-xl font-bold text-white tracking-tight">Mais Recentes</h2>
        </div>
        <%# Grid de Cards de Artigos %>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <% @recent_articles.each do |article| %>
            <%= link_to article_path(article), class: "block h-full" do %>
              <article class="bg-gray-800 rounded-xl border border-gray-700 shadow-sm hover:shadow-md transition-shadow overflow-hidden flex flex-col">
                <% if article.cover.attached? %>
                  <%= image_tag article.cover, class: "h-48 w-full object-cover", alt: article.title %>
                <% else %>
                  <img src="https://images.unsplash.com/photo-1555066931-4365d14bab8c?auto=format&fit=crop&w=600&q=80" alt="Capa" class="h-48 w-full object-cover">
                <% end %>
                <div class="p-5 flex-1 flex flex-col justify-between">
                  <div>
                    <span class="text-xs font-semibold text-[#E23D5B] uppercase tracking-wider">
                      <%= article.category.name %>
                    </span>
                    <h3 class="mt-2 text-lg font-bold text-white hover:text-indigo-600 leading-snug">
                      <%= article.title %>
                    </h3>
                    <p class="mt-2 text-gray-400 text-sm line-clamp-2">
                      <%= article.excerpt %>
                    </p>
                  </div>
                  <div class="mt-4 pt-4 border-t border-gray-700 flex items-center justify-between text-xs text-gray-400">
                    <span><%= l(article.published_at, format: :short) if article.published_at %></span>
                    <span><%= article.reading_time %> min de leitura</span>
                  </div>
                </div>
              </article>
            <% end %>
          <% end %>
        </div>
      </section>
    </main>
    <%# SIDEBAR / LATERAL (4 de 12 colunas) %>
    <aside class="lg:col-span-4 space-y-8">
      <%# WIDGET: MAIS VISTOS %>
      <div class="bg-gray-800 p-6 rounded-2xl border border-gray-700 shadow-sm">
        <h3 class="text-lg font-bold text-gray-200 border-b border-gray-700 pb-3 mb-4 flex items-center gap-2">
          <svg class="w-5 h-5 text-amber-500" fill="currentColor" viewBox="0 0 20 20">
            <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
          </svg>
          Mais Vistos
        </h3>
        <ol class="space-y-4">
          <% @popular_articles.each_with_index do |article, index| %>
            <li class="flex items-start gap-3">
              <span class="text-2xl font-black text-indigo-200 leading-none"><%= sprintf('%02d', index + 1) %></span>
              <div>
                <h4 class="text-sm font-semibold text-gray-200 hover:text-[#E23D5B] line-clamp-2">
                  <%= link_to article.title, article_path(article) %>
                </h4>
                <span class="text-xs text-gray-400 mt-1 block"><%= article.views_count %> visualizações</span>
              </div>
            </li>
          <% end %>
        </ol>
      </div>
      <%# WIDGET: RECOMENDADOS %>
      <div class="bg-gray-800 p-6 rounded-2xl border border-gray-700 shadow-sm">
        <h3 class="text-lg font-bold text-gray-200 border-b border-gray-700 pb-3 mb-4 flex items-center gap-2">
          <svg class="w-5 h-5 text-emerald-500" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M6.267 3.455a3.066 3.066 0 001.745-.723 3.066 3.066 0 013.976 0 3.066 3.066 0 011.745.723 3.066 3.066 0 012.812 2.812c.051.643.304 1.254.723 1.745a3.066 3.066 0 010 3.976 3.066 3.066 0 01-.723 1.745 3.066 3.066 0 01-2.812 2.812 3.066 3.066 0 01-1.745.723 3.066 3.066 0 01-3.976 0 3.066 3.066 0 01-1.745-.723 3.066 3.066 0 01-2.812-2.812 3.066 3.066 0 01-.723-1.745 3.066 3.066 0 010-3.976 3.066 3.066 0 01.723-1.745 3.066 3.066 0 012.812-2.812zm7.44 5.252a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
          </svg>
          Recomendados 
        </h3>
        <ol class="space-y-4">
          <% @popular_articles.each_with_index do |article, index| %>
            <li class="flex items-start gap-3">
              <span class="text-2xl font-black text-indigo-200 leading-none"><%= sprintf('%02d', index + 1) %></span>
              <div>
                <h4 class="text-sm font-semibold text-gray-200 hover:text-[#E23D5B] line-clamp-2">
                  <%= link_to article.title, article_path(article) %>
                </h4>
                <span class="text-xs text-gray-400 mt-1 block"><%= article.views_count %> visualizações</span>
              </div>
            </li>
          <% end %>
        </ol>
      </div>
    </aside>
  </div>
  <%# Controles da Paginação %>
  <%= render "shared/pagination", pagy: @pagy %>
</div>