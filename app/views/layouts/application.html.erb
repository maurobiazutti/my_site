<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "My Site" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="My Site">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= yield :head %>
    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>
  <%# bg-[#0F1115] %>
  <body class="bg-[#171a1f]">
    <header class="sticky top-0 z-50 border-b border-[#262B33] bg-[#0F1115]/80 backdrop-blur">
      <nav class="container mx-auto flex h-16 items-center justify-between px-4 sm:px-6">
        <%= link_to root_path, class: "flex items-center gap-2.5 group", aria: { label: "PÃ¡gina inicial" } do %>
          <span class="flex h-8 w-8 items-center justify-center rounded-full ring-1 ring-[#E23D5B] bg-[#171A1F] text-xs font-bold font-mono text-[#E23D5B] group-hover:bg-[#E23D5B] group-hover:text-white transition-colors">
            MB
          </span>
          <span class="font-bold tracking-tight text-white">Mauro Biazutti</span>
        <% end %>
        <div class="flex flex-1 items-center justify-center gap-1 sm:gap-2 font-bold text-2xl uppercase tracking-wide [&_a]:!text-[#E23D5B] ">
          <%= nav_link_to "Sobre Mim", root_path %>
          <%= nav_link_to "Blog", articles_path %>
          <%= nav_link_to "Contato", "#contato" %>
        </div>
        <div class="flex items-center gap-2">
          <% if Current.user.present? %>
            <%= button_to "Sign out", session_path, method: :delete, class: "inline-flex items-center px-4 py-2 border border-transparent text-sm font-medium rounded-md text-[#9AA1AC] underline hover:text-white focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-offset-[#0F1115] focus:ring-[#E23D5B]" %>
          <% else %>
            <%= link_to "Sign in", new_session_path, class: "inline-flex shrink-0 cursor-pointer items-center justify-center font-medium transition-all outline-none select-none focus-visible:ring-2 focus-visible:ring-[#E23D5B]/50 border border-[#262B33] bg-[#171A1F] hover:border-[#3A4048] text-[#E8E9EB] min-h-9 py-1.5 rounded-lg px-4 text-sm" %>
          <% end %>
          <% messages_count = Contact.count %>
          <div class="relative inline-block">
            <%= link_to contacts_path, class: "block p-2 text-[#8B92A0] hover:text-white focus:outline-none transition-colors", aria: { label: "Mensagens recebidas" } do %>
              <%= render "shared/icon_mail", icon_class: "w-7 h-7" %>
            <% end %>
            <% if messages_count.positive? %>
              <span class="absolute -top-1 -right-1 flex h-5 min-w-5 items-center justify-center rounded-full bg-[#E23D5B] px-1 font-mono text-xs font-bold text-white shadow-sm ring-2 ring-[#0F1115]">
                <%= messages_count %>
              </span>
            <% end %>
          </div>
        </div>
      </nav>
    </header>
    <main class="min-h-[calc(100vh-4rem)]">
      <%= yield %>
    </main>
  </body>
</html>