<% last ||= false %>
<div class="flex gap-4">
  <div class="flex flex-col items-center">
    <div class="mt-1.5 h-2.5 w-2.5 shrink-0 rounded-full border-2 border-rose-600 bg-white"></div>
    <% unless last %>
      <div class="w-px grow bg-gray-200"></div>
    <% end %>
  </div>
  <div class="min-w-0 flex-1 <%= last ? "" : "pb-8" %>">
    <details class="group" open>
      <summary class="flex w-full cursor-pointer list-none flex-col gap-1 text-left [&::-webkit-details-marker]:hidden">
        <div class="flex flex-col gap-1 sm:flex-row sm:items-baseline sm:justify-between sm:gap-2">
          <div class="min-w-0">
            <h3 class="text-base font-bold text-gray-900">
              <%= title %>
            </h3>
            <p class="text-sm font-medium text-gray-700">
              <%= subtitle %>
            </p>
          </div>
          <div class="flex shrink-0 items-center gap-1">
            <span class="text-xs font-semibold text-rose-600">
              <%= period %>
            </span>
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 256 256" class="h-4 w-4 text-gray-400 transition-transform duration-200 group-open:-rotate-90" fill="currentColor">
              <path d="M168.49,199.51a12,12,0,0,1-17,17l-80-80a12,12,0,0,1,0-17l80-80a12,12,0,0,1,17,17L97,128Z"></path>
            </svg>
          </div>
        </div>
      </summary>
      <div class="mt-2 text-sm text-gray-600">
        <%= yield %>
      </div>
    </details>
  </div>
</div>