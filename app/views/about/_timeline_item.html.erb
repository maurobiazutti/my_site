<% last ||= false %>
<div class="flex gap-4">
  <div class="flex flex-col items-center">
    <div class="mt-1.5 flex h-3 w-3 shrink-0 items-center justify-center">
      <div class="h-2.5 w-2.5 rotate-45 border-2 border-[#E23D5B] bg-[#171A1F]"></div>
    </div>
    <% unless last %>
      <div class="w-px grow border-l border-dashed border-[#2A2F36]"></div>
    <% end %>
  </div>

  <div class="min-w-0 flex-1 <%= last ? "" : "pb-8" %>">
    <details class="group" open>
      <summary class="flex w-full cursor-pointer list-none flex-col gap-1 text-left [&::-webkit-details-marker]:hidden">
        <div class="flex flex-col gap-1.5 sm:flex-row sm:items-baseline sm:justify-between sm:gap-2">
          <div class="min-w-0">
            <h3 class="text-base font-bold text-white">
              <%= title %>
            </h3>
            <p class="text-sm font-medium text-[#9AA1AC]">
              <%= subtitle %>
            </p>
          </div>
          <div class="flex shrink-0 items-center gap-2">
            <span class="rounded border border-[#B8905B]/30 bg-[#B8905B]/5 px-2 py-0.5 font-mono text-[11px] tracking-tight text-[#C89B6C]">
              <%= period %>
            </span>
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 256 256" class="h-4 w-4 text-[#5A616C] transition-transform duration-200 group-open:-rotate-90" fill="currentColor">
              <path d="M168.49,199.51a12,12,0,0,1-17,17l-80-80a12,12,0,0,1,0-17l80-80a12,12,0,0,1,17,17L97,128Z"></path>
            </svg>
          </div>
        </div>
      </summary>
      <div class="mt-2 text-sm text-[#9AA1AC]">
        <%= yield %>
      </div>
    </details>
  </div>
</div>
